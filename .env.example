# T.H.E.M.I.S configuration. Copy to .env (run.sh / run.bat do this for you).

# Your Groq API key (https://console.groq.com). Leave empty to run the offline demo engine.
GROQ_API_KEY=

# Default model: openai/gpt-oss-120b (recommended) or openai/gpt-oss-20b
THEMIS_MODEL=openai/gpt-oss-120b

# Set to 1 to force the offline demo engine even when a key is present.
THEMIS_DEMO=0

# Demo mode only: cosmetic pause (seconds) after each stage so the live progress is visible.
THEMIS_DEMO_DELAY=0.9
